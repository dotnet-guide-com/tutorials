{
  "Gateway": {
    "DefaultProvider": "ollama",
    "AllowProviderSelection": true,
    "MaxMessagesPerConversation": 20,
    "MaxInputCharacters": 8000
  },
  "Providers": {
    "Ollama": {
      "Enabled": true,
      "Endpoint": "http://localhost:11434",
      "Model": "qwen3.8:27b",
      "Capabilities": {
        "Streaming": true,
        "Tools": true,
        "ProviderManagedConversation": false
      }
    },
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-5-mini",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "Capabilities": {
        "Streaming": true,
        "Tools": true,
        "ProviderManagedConversation": false
      }
    },
    "OpenRouter": {
      "Enabled": false,
      "Endpoint": "https://openrouter.ai/api/v1",
      "Model": "openai/gpt-5-mini",
      "ApiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
      "Capabilities": {
        "Streaming": true,
        "Tools": true,
        "ProviderManagedConversation": false
      }
    },
    "AzureOpenAI": {
      "Enabled": false,
      "Endpoint": "",
      "Deployment": "",
      "UseDefaultAzureCredential": true,
      "ApiKeyEnvironmentVariable": "AZURE_OPENAI_API_KEY",
      "Capabilities": {
        "Streaming": true,
        "Tools": true,
        "ProviderManagedConversation": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
